#include <iostream>
using namespace std;

class Complex
{
    int real, imag;

public:
 
    Complex(int r, int i)
    {
        real = r;
        imag = i;
    }

    Complex(const Complex &c)
    {
        real = c.real;
        imag = c.imag;
    }

   
    void display()
    {
        cout << real << " + " << imag << "i" << endl;
    }
};

int main()
{
    Complex c1(5, 3);     

    Complex c2 = c1;      

    cout << "Original complex number: ";
    c1.display();

    cout << "Copied complex number: ";
    c2.display();

    return 0;
}
